# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to git.
DB_NAME=family_food_planner
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_use_a_strong_password

  # Generate with: openssl rand -base64 48
  JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
  JWT_ACCESS_EXPIRY=60

# OpenAI API key for AI recipe generation
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=CHANGE_ME_sk-...
